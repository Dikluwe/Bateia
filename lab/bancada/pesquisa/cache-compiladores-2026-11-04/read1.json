ncyScanningService】;\nL63: \nL64: 29\nL65: \nL66: 【9†30】using 【9†DependencyDirectivesTy】 =\nL67: \nL68: 31 【10†SmallVector<dependency_directives_scan::Directive, 20>】;\nL69: \nL70: 32\nL71: \nL72: 33/// Contents and directive tokens of a cached file entry. Single instance can\nL73: 34/// be shared between multiple entries.\nL74: \nL75: 【11†35】struct 【12†CachedFileContents】 {\nL76: \nL77: 【12†36】 【12†CachedFileContents】(std::unique_ptr<llvm::MemoryBuffer> Contents)\nL78: \nL79: 37 : 【13†Original】(【14†std】::move(Contents)), 【15†DepDirectives】(【16†nullptr】) {}\nL80: \nL81: 38\nL82: \nL83: 39 /// Owning storage for the original contents.\nL84: \nL85: 【13†40】 std::unique_ptr<llvm::MemoryBuffer> 【13†Original】;\nL86: \nL87: 41\nL88: \nL89: 42 /// The mutex that must be locked before mutating directive tokens.\nL90: \nL91: 【17†43】 std::mutex 【17†ValueLock】;\nL92: 【18†44】 【10†SmallVector<dependency_directives_scan::Token, 10>】 【18†DepDirectiveTokens】;\nL93: \nL94: 45 /// Accessor to the directive tokens that's atomic to avoid data races.\nL95: \nL96: 46 /// \\p CachedFileContents has ownership of the pointer.\nL97: \nL98: 【15†47】 std::atomic<const std::optional<DependencyDirectivesTy> *> 【15†DepDirectives】;\nL99: \nL100: 48\nL101: \nL102: 【19†49】 【19†~CachedFileContents】() { delete 【15†DepDirectives】.load(); }\nL103: \nL104: 50};\nL105: \nL106: 51\nL107: \nL108: 52/// An in-memory representation of a file system entity that is of interest to\nL109: 53/// the dependency scanning filesystem.\nL110: \nL111: 54///\nL112: \n--------------------------------------------------------------------------------\ninotify(7) - Linux manual page (https://www.man7.org/linux/man-pages/man7/inotify.7.html)\nciteturn3view3 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\"ref_id\":\"https://www.man7.org/linux/man-pages/man7/inotify.7.html\",\"lineno\":null}); Total lines: 748\nL0: 【0†man7.org】 > Linux > 【1†man-pages】  | 【2†Linux/UNIX system programming training†man7.org】\nL1: \nL2: * * *\nL3: \nL4: # inotify(7) — Linux manual page\nL5: \nL6: 【3†NAME】 | 【4†DESCRIPTION】 | 【5†STANDARDS】 | 【6†HISTORY】 | 【7†NOTES】 | 【8†BUGS】 | 【9†EXAMPLES】 | 【10†SEE ALSO】 | 【11†COLOPHON】\nL7: [Input] [Input] [Input]  |\nL8: \nL9:     inotify(7)           Miscellaneous Information Manual          inotify(7)\nL10: \nL11: \nL12: ## NAME         【12†top】\nL13: \nL14:            inotify - monitoring filesystem events\nL15: ## DESCRIPTION         【12†top】\nL16: \nL17:            The inotify API provides a mechanism for monitoring filesystem\nL18:            events.  Inotify can be used to monitor individual files, or to\nL19:            monitor directories.  When a directory is monitored, inotify will\nL20:            return events for the directory itself, and for files inside the\nL21:            directory.\nL22: \nL23:            The following system calls are used with this API:\nL24:            •  【13†inotify_init(2)】 creates an inotify instance and returns a file\nL25:               descriptor referring to the inotify instance.  The more recent\nL26:               【14†inotify_init1(2)】 is like 【13†inotify_init(2)】, but has a flags\nL27:               argument that provides access to some extra functionality.\nL28: \nL29:            •  【15†inotify_add_watch(2)】 manipulates the \"watch list\" associated\nL30:               with an inotify instance.  Each item (\"watch\") in the watch\nL31:               list specifies the pathname of a file or directory, along with\nL32:               some set of events that the kernel should monitor for the file\nL33:               referred to by that pathname.  【15†inotify_add_watch(2)】 either\nL34:               creates a new watch item, or modifies an existing watch.  Each\nL35:               watch has a unique \"watch descriptor\", an integer returned by\nL36:               【15†inotify_add_watch(2)】 when the watch is created.\nL37:            •  When events occur for monitored files and directories, those\nL38:               events are made available to the application as structured data\nL39:               that can be read from the inotify file descriptor using 【16†read(2)】\nL40:               (see below).\nL41: \nL42:            •  【17†inotify_rm_watch(2)】 removes an item from an inotify watch list.\nL43: \nL44:            •  When all file descriptors referring to an inotify instance have\nL45:               been closed (using 【18†close(2)】), the underlying object and its\nL46:               resources are freed for reuse by the kernel; all associated\nL47:               watches are automatically freed.\nL48: \nL49:            With careful programming, an application can use inotify to\nL50:            efficiently monitor and cache the state of a set of filesystem\nL51:            objects.  However, robust applications should allow for the fact\nL52:            that bugs in the monitoring logic or races of the kind described\n"
