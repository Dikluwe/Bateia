    "schema_version": "insight-exploration-v1",
    "id": "exploration_7ce275170fb921c5a6321b2fa2e8bda83df3f15654c52ff26a6280a582ca72d7",
    "input_sha256": "35599b1491d9078125a8afff567002e287a7073b5d384479dfe199446430abd1",
    "status": "CONTEXT_PREPARED",
    "question": "Como o XERJ governa publicação, busca e latência de leitura sob escrita concorrente, e quais custos impõem suas decisões atuais?",
    "familiar_approaches": [],
    "question_terms": [
      "xerj",
      "governa",
      "publicação",
      "busca",
      "latência",
      "leitura",
