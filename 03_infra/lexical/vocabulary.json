{
  "rules": [
    {
      "id": "structural-impact",
      "when_any": ["impacto estrutural", "consequência estrutural", "structural impact"],
      "expand_to": ["code impact analysis", "change blast radius"]
    },
    {
      "id": "command-line-interface",
      "when_any": ["interface de linha de comando", "command line tool"],
      "expand_to": ["command line interface", "cli framework"]
    },
    {
      "id": "relational-persistence",
      "when_any": ["armazenar dados relacionais", "persistência relacional"],
      "expand_to": ["relational database", "sql persistence"]
    },
    {
      "id": "web-interface",
      "when_any": ["interface web", "aplicação web"],
      "expand_to": ["web user interface", "frontend framework"]
    },
    {
      "id": "event-processing",
      "when_any": ["eventos assíncronos", "processar eventos"],
      "expand_to": ["event driven architecture", "message queue"]
    },
    {
      "id": "static-analysis",
      "when_any": ["analisar código sem executar", "análise estática"],
      "expand_to": ["static code analysis", "source code analyzer"]
    },
    {
      "id": "coding-agent-context",
      "when_any": ["contexto para agentes de programação", "agentes de programação"],
      "expand_to": ["coding agent context", "repository memory"]
    },
    {
      "id": "recipe-organization",
      "when_any": ["organizar receitas culinárias", "receitas culinárias"],
      "expand_to": ["recipe manager", "meal planning"]
    },
    {
      "id": "robust-predicates.translation.en",
      "when_any": ["predicados geometricos de orientacao e in-circle robustos a casos quase degenerados"],
      "expand_to": ["robust geometric orientation and in-circle predicates for nearly degenerate cases"],
      "strategy": "technical-lexicon-v1",
      "discriminators": ["orientation", "in-circle"]
    },
    {
      "id": "robust-predicates.symbol-pair",
      "when_any": ["predicados geometricos de orientacao e in-circle robustos a casos quase degenerados"],
      "expand_to": ["orient2d incircle"],
      "strategy": "technical-lexicon-v1",
      "discriminators": ["orient2d", "incircle"]
    },
    {
      "id": "robust-predicates.reference-pair",
      "when_any": ["predicados geometricos de orientacao e in-circle robustos a casos quase degenerados"],
      "expand_to": ["Shewchuk exact predicates"],
      "strategy": "technical-lexicon-v1",
      "discriminators": ["Shewchuk", "predicates"]
    }
  ]
}
