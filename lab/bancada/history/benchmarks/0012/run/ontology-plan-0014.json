{
  "idea": {
    "problem": "Evitar iniciar software do zero quando projetos, componentes ou padrões reutilizáveis já resolvem toda ou parte da ideia, produzindo uma decisão de partida baseada em evidências.",
    "users": [
      "desenvolvedores iniciando um projeto",
      "mantenedores avaliando reutilização",
      "agentes de programação"
    ],
    "capabilities": [
      "decompor uma ideia em capacidades e restrições rastreáveis",
      "descobrir projetos públicos privados ou locais por intenção funcional",
      "rejeitar projetos lexicalmente parecidos e funcionalmente irrelevantes",
      "comprovar capacidades em documentação manifestos código e testes",
      "comparar cobertura funcional licença manutenção e operação",
      "decidir entre fork extend compose integrate reference build e inconclusive",
      "recuperar evidência faltante sem repetir coleta genérica",
      "reconhecer capacidades já existentes no próprio projeto",
      "propor a menor composição de projetos para cobrir lacunas reais",
      "reproduzir julgamento offline com artefatos e commits congelados"
    ],
    "constraints": [
      "sem LLM no pipeline principal",
      "evidência vinculada a repo commit path e hash",
      "suporte a repositórios puramente locais",
      "falha ou opacidade não pode virar ausência ou build",
      "replay offline"
    ],
    "non_goals": [
      "buscar somente por palavras iguais",
      "ranquear apenas por estrelas",
      "gerar código automaticamente",
      "copiar código de concorrentes",
      "tratar jogo Katamari ou autofagia biológica como seleção de software"
    ],
    "preferred_stack": [
      "go",
      "cli",
      "json"
    ]
  },
