    {"id":"M03-license-bypass","attack":"popular full-coverage candidate has disallowed license","witness":"BLOCKED, excluded, never top_choice"},
    {"id":"M04a-maintenance-bypass","attack":"archived candidate when archived is forbidden","witness":"BLOCKED, excluded, never top_choice"},
    {"id":"M04b-operation-bypass","attack":"local operation ABSENT when require_local is true","witness":"BLOCKED, excluded, never top_choice"},
    {"id":"M05-target-self","attack":"target has another commit and maximum score","witness":"only excluded as NOT_ALTERNATIVE"},
    {"id":"M06a-target-case","attack":"vary owner/repo case","witness":"same canonical target identity"},
    {"id":"M06b-target-http-url","attack":"use GitHub HTTP(S) URL","witness":"same canonical target identity"},
    {"id":"M06c-target-ssh","attack":"use git@github.com:owner/repo","witness":"same canonical target identity"},
    {"id":"M06d-target-dotgit","attack":"append .git suffix","witness":"same canonical target identity"},
    {"id":"M07a-empty-commit","attack":"assessment commit empty","witness":"INCONCLUSIVE in excluded"},
