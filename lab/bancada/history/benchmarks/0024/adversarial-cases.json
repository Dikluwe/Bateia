    {"id":"M07c-divergent-commit","attack":"snapshot and assessment commits differ","witness":"INCONCLUSIVE in excluded"},
    {"id":"M07d-assessment-orphan","attack":"snapshot has no assessment","witness":"one INCONCLUSIVE in excluded"},
    {"id":"M07e-snapshot-orphan","attack":"assessment has no snapshot metadata","witness":"one INCONCLUSIVE in excluded"},
    {"id":"M08a-capability-unknown","attack":"required capability omitted, duplicated or INCONCLUSIVE","witness":"INCONCLUSIVE in excluded"},
    {"id":"M08b-capability-conflict","attack":"required capability CONFLICT","witness":"BLOCKED in excluded"},
    {"id":"M08b2-alignment-conflict","attack":"problem alignment CONFLICT","witness":"BLOCKED in excluded"},
    {"id":"M08c-license-partial","attack":"license PARTIAL/INCONCLUSIVE","witness":"INCONCLUSIVE in excluded"},
    {"id":"M08d-license-conflict","attack":"license ABSENT/CONFLICT","witness":"BLOCKED in excluded"},
    {"id":"M08e-maintenance-partial","attack":"maintenance PARTIAL/INCONCLUSIVE","witness":"INCONCLUSIVE in excluded"},
    {"id":"M08f-operation-partial","attack":"required local operation PARTIAL/INCONCLUSIVE","witness":"INCONCLUSIVE in excluded"},
    {"id":"M09-failure-ignored","attack":"add collection failure to otherwise strong candidate","witness":"INCONCLUSIVE unless conclusively BLOCKED"},
    {"id":"M10-fallback-top-choice","attack":"all candidates blocked/inconclusive/reference","witness":"top_choice absent"},
