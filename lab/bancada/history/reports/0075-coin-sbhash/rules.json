{
  "schema_version": "2",
  "version": "2026-09-17.coin-sbhash",
  "rules": [
    {
      "id": "self-assignment-guard-hashtable",
      "family": "cpp-api-design",
      "provenance": "coin-sbhash-study",
      "target_hints": ["hashtable.h", "robin_hood.h"],
      "capability_terms": [
        "guard copy assignment against self-assignment as the first statement, before any destructive mutation"
      ],
      "strong_evidence": [
        { "kind": "symbol", "patterns": ["&__ht == this", "&o == this", "&other == this"] },
        { "kind": "test", "patterns": ["&__ht == this", "&o == this"] }
      ],
      "supporting_evidence": [
        { "kind": "documentation", "patterns": ["self-assignment", "self assignment"] },
        { "kind": "file", "patterns": ["hashtable.h", "robin_hood.h"] }
      ],
      "negative_evidence": ["not implemented", "planned"]
    },
    {
      "id": "rehash-allocate-before-publish",
      "family": "cpp-api-design",
      "provenance": "coin-sbhash-study",
      "target_hints": ["hashtable.h"],
      "capability_terms": [
        "publish a rehashed table's new bucket array only after its allocation succeeds, without destroying any existing node on the failing path"
      ],
      "strong_evidence": [
        { "kind": "symbol", "patterns": ["_M_allocate_buckets", "_M_rehash_policy._M_reset"] },
        { "kind": "test", "patterns": ["_M_allocate_buckets"] }
      ],
      "supporting_evidence": [
        { "kind": "documentation", "patterns": ["buckets allocation failed", "restore hash policy"] },
        { "kind": "file", "patterns": ["hashtable.h"] }
      ],
      "negative_evidence": ["not implemented", "planned"]
    },
    {
      "id": "resize-relinks-nodes",
      "family": "cpp-api-design",
      "provenance": "coin-sbhash-study",
      "target_hints": ["hashtable.h"],
      "capability_terms": [
        "relink existing nodes into new buckets during resize instead of copying and destroying every key and value"
      ],
      "strong_evidence": [
        { "kind": "symbol", "patterns": ["_M_rehash_aux", "__p->_M_nxt ="] },
        { "kind": "test", "patterns": ["_M_rehash_aux"] }
      ],
      "supporting_evidence": [
        { "kind": "documentation", "patterns": ["rehash", "relink"] },
        { "kind": "file", "patterns": ["hashtable.h"] }
      ],
      "negative_evidence": ["not implemented", "planned"]
    },
    {
      "id": "prime-modulo-bucket-index",
      "family": "cpp-api-design",
      "provenance": "coin-sbhash-study",
      "target_hints": ["hashtable_policy.h"],
      "capability_terms": [
        "reduce a hash value to a bucket index using a prime bucket count with plain modulo instead of a power-of-two mask"
      ],
      "strong_evidence": [
        { "kind": "symbol", "patterns": ["_Mod_range_hashing", "_Prime_rehash_policy", "__num % __den"] },
        { "kind": "test", "patterns": ["_Prime_rehash_policy"] }
      ],
      "supporting_evidence": [
        { "kind": "documentation", "patterns": ["smallest prime", "prime that keeps the load factor"] },
        { "kind": "file", "patterns": ["hashtable_policy.h"] }
      ],
      "negative_evidence": ["not implemented", "planned"]
    },
    {
      "id": "avalanche-mixing-step",
      "family": "cpp-api-design",
      "provenance": "coin-sbhash-study",
      "target_hints": ["robin_hood.h"],
